# Possessions — build, test, run, ship

build:
    swift build

test:
    swift test

run:
    swift run Still

# Ad-hoc local build: distributable .app + .dmg
release:
    ./scripts/release.sh

# Signed and optionally notarized release.
# Usage: IDENTITY="Developer ID Application: …" [APPLE_ID=… TEAM_ID=…] just release-signed
release-signed:
    ./scripts/release.sh