# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Still' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Some pods still declare old iOS floors, which current Xcode rejects.
    # Raise anything below the app's floor (mirrors Thames).
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current && Gem::Version.new(current) < Gem::Version.new('17.0')
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
        end
      end
    end

    # react-native-bottom-tabs quotes RCTConversions.h, which only exists inside the prebuilt
    # React xcframework — not in the flattened pod headers — so expose that Headers dir to it.
    # The headers are identical across slices; one slice path compiles every platform.
    prebuilt_headers = 'React-Core-prebuilt/React.xcframework/ios-arm64_x86_64-simulator/React.framework/Headers'
    if File.directory?(File.join(installer.sandbox.root.to_s, prebuilt_headers))
      installer.pods_project.targets.each do |target|
        next unless target.name == 'react-native-bottom-tabs'
        target.build_configurations.each do |build_config|
          search_paths = build_config.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)'
          search_paths = [search_paths] unless search_paths.is_a?(Array)
          search_paths << %("${PODS_ROOT}/#{prebuilt_headers}")
          build_config.build_settings['HEADER_SEARCH_PATHS'] = search_paths
        end
      end
    end
  end
end
